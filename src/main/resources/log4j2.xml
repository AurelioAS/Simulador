<?xml version="1.0" encoding="UTF-8"?>

<Configuration strict="true" status="WARN" monitorInterval="30">

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout disableAnsi="false">
                <Pattern>%5sn - %style{%d{yyyy-MM-dd HH:mm:ss.SSS}}{magenta} - %highlight{%-5p} [%style{%-25.25t}{bright,blue}] [%-40.40blue{%logger{2}:%L}] - %highlight{%m}%n</Pattern>
            </PatternLayout>
        </Console>
        <RollingFile name="MyLogFile" fileName="./logs/app.log" filePattern="./logs/bak/app-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} - %-5p [%-20.20t] %-40.40logger{2} - %m%n" />
            <Policies>
                <SizeBasedTriggeringPolicy size="5 MB" />
            </Policies>
            
            <DefaultRolloverStrategy max="10"> 
                 <Delete basePath="./logs/bak" maxDepth="1">
                    <IfFileName glob="app-*.log.gz" />
                    <IfLastModified age="7d" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <RollingFile name="MyLogFile" fileName="./logs/app.log" filePattern="./logs/app-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout disableAnsi="false">
                <!-- <Pattern>${PATTERN}</Pattern> -->
                <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} - %-5p [%-20.20t] %-40.40logger{2} - %m%n</Pattern>
            </PatternLayout>
            <!-- <CronTriggeringPolicy schedule="0 0/1 * 1/1 * ? *"/>  -->
            <Policies>
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
            <DefaultRolloverStrategy max="15">
                <Delete basePath="./logs/bak" maxDepth="1">
                    <IfAny>
                        <IfLastModified age="3m"/>
                        <IfAccumulatedFileSize exceeds="50MB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
            <ThresholdFilter level="debug"/>
        </RollingFile>
        <RollingFile name="MqLibFile" fileName="./logs/mqlib.log" filePattern="./logs/mqlib-%i.log">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} - %-5p [%-30.30t] %-40.40logger{4} - %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <SizeBasedTriggeringPolicy size="5 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10"/>
            <ThresholdFilter level="debug"/>
        </RollingFile>
        <RollingFile name="FileAppender"
                     fileName="logs/mq-forwarder.log"
                     filePattern="logs/mq-forwarder-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5p %c{1} - %m%n</pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
        </RollingFile>
 	    <Async name="Async" bufferSize="1048576">
	      <AppenderRef ref="Console"/>
	    </Async>
<!--	    <Async name="AsyncFile" bufferSize="524288">
	      <AppenderRef ref="MyLogFile"/>
	      <LinkedTransferQueue/>
	    </Async>
        <Async name="AsyncFileMq" bufferSize="524288">
          <AppenderRef ref="MqLibFile"/>
        </Async>  -->   
    </Appenders>
    <Loggers>
        <Root level="info"  additivity="false">
            <AppenderRef ref="Console"  />
            <AppenderRef ref="MyLogFile"  /> 
        </Root>    
        <Logger name="com.simulador" level="debug" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="MyLogFile"  /> 
        </Logger>    
        <Logger name="com.github.codemonstur" level="debug" additivity="false">
            <AppenderRef ref="Async" />
        </Logger>    
    </Loggers>
</Configuration>